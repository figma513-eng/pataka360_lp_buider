# ==============================================================
# Lynk Builder — Environment Variables Example (Mac / VPS / Prod)
# Salin berkas ini menjadi .env lalu sesuaikan untuk mesin Anda.
# JANGAN PERNAH commit berkas .env berisi rahasia asli ke Git!
# ==============================================================

# Server Binding & Runtime
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
APP_URL="http://localhost:3000"

# Cookie Session Secret (WAJIB >= 32 karakter acak di production)
# Generate di Mac/Linux dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-output-openssl-rand-hex-32-minimal-32-karakter"

# PostgreSQL Database Connection
# Gunakan DATABASE_URL ATAU variabel terpisah PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE
# DATABASE_URL="postgresql://postgres:password_anda@localhost:5432/lynk_builder"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="lynk_builder"

# TLS / SSL PostgreSQL:
# - Untuk PostgreSQL lokal di Mac/laptop: "false"
# - Untuk cloud PostgreSQL (RDS/Neon/Supabase/Cloud SQL): "true"
PGSSL="false"
# Opsional: sertifikat CA custom (isi inline PEM atau path file .pem)
# PGSSL_CA=""
# PGSSL_CA_FILE="/path/to/ca-certificate.pem"
# Hanya untuk dev/staging non-production jika sertifikat self-signed:
# PGSSL_REJECT_UNAUTHORIZED="true"

# Fallback Storage Policy (Development vs Production)
# Di production (NODE_ENV=production), server gagal-tertutup (503) jika PostgreSQL mati,
# kecuali variabel berikut diset eksplisit ke "true":
# ALLOW_LOCAL_JSON_STORAGE="false"
# LYNK_DATA_DIR=".data"

# Rate Limiting Auth & API
# AUTH_RATE_LIMIT_MAX="15"

# Trust Proxy (atur "1" / "true" jika di belakang Nginx / Caddy / Cloudflare / Cloud Run)
# TRUST_PROXY="1"

# Opsional: Meta Conversions API & Outgoing Webhook HMAC Signing
# META_CAPI_ACCESS_TOKEN=""
# WEBHOOK_SIGNING_SECRET=""
